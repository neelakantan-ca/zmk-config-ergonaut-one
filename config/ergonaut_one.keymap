#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        configuration {
            if-layers = <2 5>;
            then-layer = <6>;
        };
    };

    behaviors {
        Quotes: Quotes {
            compatible = "zmk,behavior-tap-dance";
            label = "QUOTES";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DOUBLE_QUOTES>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 23 22 21 20 19 18 30 31 32 33 34 35 39 40 41 38 36 37>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 41 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "MAIN";
            bindings = <
&none  &kp Q         &kp W            &kp E            &kp R              &kp T      &kp Y        &kp U               &kp I             &kp O             &kp P                    &none
&none  &hml LCTRL A  &hml LEFT_ALT S  &hml LEFT_GUI D  &hml LEFT_SHIFT F  &kp G      &kp H        &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RCTRL SINGLE_QUOTE  &none
&none  &kp Z         &kp X            &kp C            &kp V              &kp B      &kp N        &kp M               &kp COMMA         &kp PERIOD        &kp SLASH                &none
                                      &lt 3 ESCAPE     &lt 2 BACKSPACE    &lt 1 TAB  &lt 4 ENTER  &lt 5 SPACE         &lt 0 DEL
            >;

            label = "base";
        };

        Navigation {
            bindings = <
&none  &none         &none         &none      &none           &none  &kp K_REDO  &kp K_PASTE    &kp K_COPY    &kp K_CUT  &kp K_UNDO    &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none  &kp LEFT    &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp CAPSLOCK  &none
&none  &none         &none         &none      &none           &none  &kp HOME    &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &kp INSERT    &none
                                   &none      &none           &none  &kp ENTER   &kp BACKSPACE  &kp DELETE
            >;

            label = "navigation";
        };

        Number {
            bindings = <
&none  &none         &none         &none      &none           &none  &kp LBKT   &kp N7        &kp N8        &kp N9        &kp RBKT  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none  &kp EQUAL  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SEMI  &none
&none  &none         &none         &none      &none           &none  &kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BSLH  &none
                                   &none      &none           &none  &kp ENTER  &kp N0        &none
            >;

            label = "numbers";
        };

        Symbols {
            bindings = <
&kp GRAVE      &kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)  &kp LS(RBRC)  &kp RBKT     &kp BSLH       &kp LS(PIPE)      &none         &none
&kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)   &kp LS(RPAR)  &kp SQT       &kp LS(DQT)  &none          &none             &kp COLON     &none
&kp MINUS      &kp LS(UNDER)  &kp EQUAL     &kp LS(PLUS)  &kp LBKT       &kp LS(LBRC)  &none         &none        &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION  &trans
                                            &trans        &trans         &trans        &trans        &trans       &trans
            >;

            label = "symbols";
        };

        Function {
            bindings = <
&none  &none  &kp F7  &kp F8  &kp F9  &kp F12  &none  &none  &none  &none  &none  &none
&none  &none  &kp F4  &kp F5  &kp F6  &kp F11  &none  &none  &none  &none  &none  &none
&none  &none  &kp F1  &kp F2  &kp F3  &kp F10  &none  &none  &none  &none  &none  &none
                      &none   &none   &none    &none  &none  &none
            >;

            label = "functions";
        };

        Media {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "media";
        };

        Settings {
            display-name = "ADJ";
            bindings = <
&none  &none  &none       &none        &studio_unlock  &none   &none       &none         &none         &none         &none       &bt BT_CLR_ALL
&none  &none  &none       &bootloader  &none           &none   &bt BT_PRV  &bt BT_SEL 4  &none         &none         &bt BT_NXT  &bt BT_CLR
&none  &none  &sys_reset  &none        &none           &none   &none       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none       &bt BT_DISC 0
                          &trans       &none           &trans  &none       &bt BT_SEL 0  &trans
            >;

            label = "settings";
        };
    };
};
