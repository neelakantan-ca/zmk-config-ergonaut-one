#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        configuration {
            if-layers = <2 5>;
            then-layer = <6>;
        };

        PC_NAV {
            if-layers = <1 7>;
            then-layer = <8>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 23 22 21 20 19 18 30 31 32 33 34 35 39 40 41 38 36 37>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 41 40>;
        };

        hsl: hsl {
            compatible = "zmk,behavior-hold-tap";
            label = "HSL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 23 22 21 20 19 18 30 31 32 33 34 35 39 40 41 38 36 37>;
        };

        hsr: hsr {
            compatible = "zmk,behavior-hold-tap";
            label = "HSR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 41 40>;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_bspc: lt_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BSPC";
            bindings = <&mo>, <&bspc_del>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "MAIN";
            bindings = <
&none                         &kp Q         &kp W            &kp E            &kp R              &kp T      &kp Y        &kp U               &kp I             &kp O             &kp P                    &none
&mt LG(LA(LS(LCTRL))) ESCAPE  &hml LCTRL A  &hml LEFT_ALT S  &hml LEFT_GUI D  &hsl LEFT_SHIFT F  &kp G      &kp H        &hsr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RCTRL SINGLE_QUOTE  &none
&none                         &kp Z         &kp X            &kp C            &kp V              &kp B      &kp N        &kp M               &kp COMMA         &kp PERIOD        &kp SLASH                &none
                                                             &lt 4 ESCAPE     &lt_bspc 2 0       &lt 1 TAB  &lt 3 ENTER  &kp SPACE           &lt 5 DEL
            >;

            label = "base";
        };

        Navigation {
            bindings = <
&none  &none      &kp LG(LEFT)  &kp LA(LEFT_ARROW)  &kp LA(RIGHT)     &kp LG(RIGHT)  &kp LG(LS(Z))  &kp LG(V)      &kp LG(C)     &kp LG(X)  &kp LG(Z)     &none
&none  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI        &kp LEFT_SHIFT    &none          &kp LEFT       &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp CAPSLOCK  &none
&none  &none      &none         &kp LS(LG(LBKT))    &kp LS(LG(RBKT))  &none          &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &kp INSERT    &none
                                &none               &none             &none          &kp ENTER      &kp BACKSPACE  &kp DELETE
            >;

            label = "navigation";
        };

        Number {
            bindings = <
&none  &none      &none         &none     &none           &none  &kp LBKT   &kp N7        &kp N8        &kp N9        &kp RBKT  &none
&none  &kp LCTRL  &kp LEFT_ALT  &kp LGUI  &kp LEFT_SHIFT  &none  &kp EQUAL  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SEMI  &none
&none  &none      &none         &none     &none           &none  &kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BSLH  &none
                                &none     &none           &none  &kp ENTER  &kp N0        &kp DOT
            >;

            label = "numbers";
        };

        Symbols {
            bindings = <
&none  &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR   &none
&none  &kp GRAVE  &kp MINUS  &kp EQUAL  &none       &none        &none      &kp LBKT  &kp RBKT  &kp BSLH  &kp SEMI   &none
&none  &kp TILDE  &kp UNDER  &kp PLUS   &none       &none        &none      &kp LBRC  &kp RBRC  &kp PIPE  &kp COLON  &none
                             &trans     &trans      &trans       &trans     &trans    &trans
            >;

            label = "symbols";
        };

        Function {
            bindings = <
&none  &none  &kp F7  &kp F8  &kp F9  &kp F12  &none  &none  &none  &none  &none  &none
&none  &none  &kp F4  &kp F5  &kp F6  &kp F11  &none  &none  &none  &none  &none  &none
&none  &none  &kp F1  &kp F2  &kp F3  &kp F10  &none  &none  &none  &none  &none  &none
                      &none   &none   &none    &none  &none  &none
            >;

            label = "functions";
        };

        Media {
            bindings = <
&trans  &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp C_PREV  &kp C_PP      &kp C_NEXT    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &kp C_BRI_DN  &kp C_BRI_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans  &trans  &trans  &trans
            >;

            label = "media";
        };

        Settings {
            display-name = "ADJ";
            bindings = <
&none  &none  &tog 7      &none        &studio_unlock  &none   &none       &out OUT_TOG  &none         &none         &none       &bt BT_CLR_ALL
&none  &none  &none       &bootloader  &none           &none   &bt BT_PRV  &bt BT_SEL 4  &none         &none         &bt BT_NXT  &bt BT_CLR
&none  &none  &sys_reset  &none        &none           &none   &none       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none       &bt BT_DISC 0
                          &trans       &none           &trans  &none       &bt BT_SEL 0  &trans
            >;

            label = "settings";
        };

        PC {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        PC_NAV {
            bindings = <
&trans  &trans     &kp HOME      &kp LC(LEFT)     &kp LC(RIGHT)   &kp END  &kp LC(Y)  &kp LC(V)      &kp LC(C)     &kp LC(X)  &kp LC(Z)     &trans
&trans  &kp LCTRL  &kp LEFT_ALT  &kp LGUI         &kp LEFT_SHIFT  &trans   &kp LEFT   &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp CAPSLOCK  &trans
&trans  &trans     &trans        &kp LC(LS(TAB))  &kp LC(TAB)     &trans   &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &kp INSERT    &trans
                                 &trans           &trans          &trans   &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };
    };
};
